{
	// Place your roku-screensaver workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"Plugin boilerplate": {
		"scope": "brightscript",
		"prefix": "plugin",
		"body": [
			"' Plugin name: $1",
			"' Creation date [yyyy-mm-dd]: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
			"' Author: $2",
			"",
			"",
			"sub $1_Init(app_ctx, plugin_state)",
			"\t' Your initalization code for the plugin goes here",
			"\t$0",
			"endsub",
			"",
			"sub $1_Loop(app_ctx, plugin_state, render_ctx)",
			"\t' Your render loop or update loop for the plugin goes here",
			"\t",
			"\t' Lil border box",
    		"\tapp_ctx.screen.DrawRect(render_ctx.x, render_ctx.y, render_ctx.width, render_ctx.height, &h011926FF)",
    		"\tapp_ctx.screen.DrawRect(render_ctx.x + 2, render_ctx.y + 2, render_ctx.width - 4, render_ctx.height - 4, &h000000FF)",
			"",
			"endsub"
		],
		"description": "A plugin boilderplate code",
		"isFileTemplate": true
	}
}